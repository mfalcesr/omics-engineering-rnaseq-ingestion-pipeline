# RNA-seq ingestion: database connection.
# Copy this file to `.env` and adjust as needed. NEVER commit `.env` (see .gitignore).
# docker-compose.yml and src/rnaseq_ingest/config.py both read these variables.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=rnaseq_db
DB_USER=rnaseq_user
DB_PASSWORD=rnaseq_password

# Optional: overrides the composed DB_* connection string if set.
# DATABASE_URL=postgresql://rnaseq_user:rnaseq_password@localhost:5432/rnaseq_db

# Optional: recorded in sample.ingested_by for audit. Defaults to the OS user.
# INGEST_ACTOR=ingest-cli

# ── Read API (optional, only needed for `uvicorn rnaseq_ingest.api:app`) ──────
# The API connects as `rnaseq_api`, a SELECT-only role created by
# db/migrations/002_api_readonly_role.sql. It never uses the loader's credentials.

# Password for the rnaseq_api role. Consumed by migration 002 (psql -v api_pw=...).
API_DB_PASSWORD=change-me

# The API's own connection string. If unset, the API falls back to the DB_* variables
# above with the user swapped for `rnaseq_api` and this password.
API_DATABASE_URL=postgresql://rnaseq_api:change-me@localhost:5432/rnaseq_db

# Upper bound on concurrent database connections held by the pool.
# API_POOL_MAX_SIZE=10
