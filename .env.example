# RNA-seq ingestion: database connection.
# Copy this file to `.env` and adjust as needed. NEVER commit `.env` (see .gitignore).
# docker-compose.yml and src/rnaseq_ingest/config.py both read these variables.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=rnaseq_db
DB_USER=rnaseq_user
DB_PASSWORD=rnaseq_password

# Optional: overrides the composed DB_* connection string if set.
# DATABASE_URL=postgresql://rnaseq_user:rnaseq_password@localhost:5432/rnaseq_db

# Optional: recorded in sample.ingested_by for audit. Defaults to the OS user.
# INGEST_ACTOR=ingest-cli
